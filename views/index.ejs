<%- include("partials/header", {
    title: "CampusConnect"
}) %>


<section class="hero">

    <div class="hero-content">

        <span class="badge">
            COLLEGE EVENT PLATFORM
        </span>

        <h1>
            Discover what's happening
            <span>on campus.</span>
        </h1>

        <p>
            CampusConnect helps students discover,
            register for and manage college events
            all in one place.
        </p>

        <div class="hero-buttons">

            <a
                href="/signup"
                class="btn primary"
            >
                Get Started
            </a>

            <a
                href="/login"
                class="btn secondary"
            >
                Login
            </a>

        </div>

    </div>


    <div class="hero-card">

        <div class="calendar-icon">
            📅
        </div>

        <h3>
            Upcoming Events
        </h3>

        <p>
            Hackathons · Workshops · Sports ·
            Cultural Events
        </p>

        <div class="mini-event">
            <strong>TechFest 2026</strong>
            <span>October 15 · Main Auditorium</span>
        </div>

        <div class="mini-event">
            <strong>Cultural Night</strong>
            <span>October 22 · Open Grounds</span>
        </div>

    </div>

</section>


<section class="features">

    <div class="feature-card">

        <div>🔎</div>

        <h3>
            Discover Events
        </h3>

        <p>
            Find workshops, competitions,
            cultural programs and more.
        </p>

    </div>


    <div class="feature-card">

        <div>🎟️</div>

        <h3>
            Easy Registration
        </h3>

        <p>
            Register for events with
            just a few clicks.
        </p>

    </div>


    <div class="feature-card">

        <div>🔔</div>

        <h3>
            Stay Updated
        </h3>

        <p>
            Get notifications about your
            registered events.
        </p>

    </div>

</section>


<%- include("partials/footer") %>